@startuml
title Iterator en el CRUD de estudiantes
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial

package "Presentación" {
  class Main {
    +main(argumentos: String[]): void
  }
  class VentanaCrudEstudiantes {
    -refrescarTabla(): void
  }
}

package "Lógica" {
  interface MediadorCrud {
    +crearIterador(): Iterador
  }
  class MediadorCrudEstudiantes {
    -control: ControlEstudiante
    +crearIterador(): Iterador
  }
  class ControlEstudiante {
    -estudiantes: Map<Integer, Estudiante>
    +crearIterador(): Iterador
  }
  interface Iterador {
    +haySiguiente(): boolean
    +siguiente(): Estudiante
  }
  class IteradorEstudiante {
    -estudiantes: List<Estudiante>
    -posicion: int
    +haySiguiente(): boolean
    +siguiente(): Estudiante
  }
}

package "Modelo" {
  class Estudiante
}

Main ..> VentanaCrudEstudiantes : abre
VentanaCrudEstudiantes ..> MediadorCrud : solicita iterador
MediadorCrudEstudiantes ..|> MediadorCrud
MediadorCrudEstudiantes --> ControlEstudiante : delega
ControlEstudiante ..> IteradorEstudiante : crea sobre una copia
IteradorEstudiante ..|> Iterador
IteradorEstudiante --> Estudiante : entrega uno a uno
VentanaCrudEstudiantes ..> Estudiante : muestra filas en JTable
@enduml
