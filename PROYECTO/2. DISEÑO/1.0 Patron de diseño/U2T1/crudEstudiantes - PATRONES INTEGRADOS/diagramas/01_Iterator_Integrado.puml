@startuml
title Iterator integrado en el CRUD de estudiantes
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial

package "Presentacion" {
  class Main {
    +main(argumentos: String[]): void
    -listar(mediador: MediadorCrud): void
  }
}

package "Logica" {
  interface MediadorCrud {
    +crearIterador(): Iterador
  }
  class MediadorCrudEstudiantes {
    -control: ControlEstudiante
    +crearIterador(): Iterador
  }
  class ControlEstudiante {
    -repositorio: RepositorioEstudiante
    +crearIterador(): Iterador
  }
  interface RepositorioEstudiante {
    +crearIterador(): Iterador
  }
  interface Iterador {
    +haySiguiente(): boolean
    +siguiente(): Estudiante
  }
}

package "Datos" {
  class RepositorioEstudianteMemoria {
    -estudiantes: Map<Integer, Estudiante>
    +crearIterador(): Iterador
  }
  class IteradorEstudiante {
    -estudiantes: List<Estudiante>
    -posicion: int
    +haySiguiente(): boolean
    +siguiente(): Estudiante
  }
}

package "Modelo" {
  class Estudiante
}

Main ..> MediadorCrud : solicita recorrido
MediadorCrudEstudiantes ..|> MediadorCrud
MediadorCrudEstudiantes --> ControlEstudiante : delega
ControlEstudiante --> RepositorioEstudiante : consulta
RepositorioEstudianteMemoria ..|> RepositorioEstudiante
RepositorioEstudianteMemoria ..> IteradorEstudiante : crea
IteradorEstudiante ..|> Iterador
IteradorEstudiante --> Estudiante : entrega
@enduml
