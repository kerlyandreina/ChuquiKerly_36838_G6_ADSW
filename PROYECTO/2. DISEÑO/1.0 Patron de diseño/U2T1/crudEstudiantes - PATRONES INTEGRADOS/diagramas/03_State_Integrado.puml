@startuml
title State integrado en el CRUD de estudiantes
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial

package "Logica" {
  class ControlEstudiante {
    +actualizarEstudiante(id: int, nombre: String, edad: int): String
    +cambiarEstado(id: int, opcion: int): String
  }
}

package "Modelo" {
  class Estudiante {
    +id: int
    +nombre: String
    +edad: int
    -estado: EstadoEstudiante
    +actualizar(nombre: String, edad: int): String
    +cambiarEstado(estado: EstadoEstudiante): void
    +nombreEstado(): String
  }
  interface EstadoEstudiante {
    +actualizar(estudiante: Estudiante, nombre: String, edad: int): String
    +nombre(): String
  }
  class EstadoActivo {
    +actualizar(...): String
    +nombre(): String
  }
  class EstadoInactivo {
    +actualizar(...): String
    +nombre(): String
  }
}

ControlEstudiante --> Estudiante : solicita cambio / actualizacion
Estudiante o--> EstadoEstudiante : estado actual
EstadoActivo ..|> EstadoEstudiante
EstadoInactivo ..|> EstadoEstudiante
ControlEstudiante ..> EstadoActivo : selecciona
ControlEstudiante ..> EstadoInactivo : selecciona
@enduml
